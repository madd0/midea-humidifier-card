{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Home Assistant",
      "type": "shell",
      "command": "bash .devcontainer/develop.sh",
      "dependsOn": "Watch card",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Watch card",
      "type": "shell",
      "command": "yarn start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rollup",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*bundles.*",
          "endsPattern": ".*created .* in.*"
        }
      },
      "presentation": {
        "panel": "dedicated"
      }
    }
  ]
}